# Postgres connection string (Supabase or Neon recommended)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:password@host:5432/nymbus_db

# Anthropic Claude API key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FRED API key (free registration at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Aggregator provider — "mock" uses built-in fixture data, "plaid" requires additional setup
# Valid values: mock | plaid
AGGREGATOR_PROVIDER=mock
